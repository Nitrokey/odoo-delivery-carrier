<odoo>
    <record id="ups_shipping_delivery_order_view" model="ir.ui.view">
        <field name="name">stock.picking.ups.paperless</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position='inside'>
                <page
                    string="UPS Paperless Invoice"
                    attrs="{'invisible': [('delivery_type', '!=', 'ups')]}"
                >
                    <group>
                        <group>
                            <field
                                name="document_id"
                                attrs="{'invisible': [('ups_paperless_auto_send', '=', False)]}"
                            />
                            <button
                                name="generate_paperless_invoice"
                                string="Generate Paperless Invoice"
                                type='object'
                                class="fa fa-arrow-right oe_link"
                                attrs="{'invisible': ['|', ('state', '!=', 'done'), ('ups_paperless_auto_send', '=', True)]}"
                            />
                        </group>
                        <field name="ups_paperless_document">
                            <tree nolabel="1" editable="bottom">
                                <field name="ups_paperless_file" filename="file_name" />
                                <field name="file_name" />
                                <field name="ups_document_type" />
                                <button
                                    name="ups_paperless_file_download"
                                    string="File Download"
                                    type="object"
                                    class="fa fa-arrow-right oe_link"
                                />
                            </tree>
                        </field>

                        <group>
                            <field name="ups_paperless_auto_send" />
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//group[@name='carrier_data']" position="inside">
                <field
                    name="ups_cod_amount"
                    readonly="1"
                    attrs="{'invisible': [('delivery_type', '!=', 'ups')]}"
                />
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field
                    name="ups_description"
                    attrs="{'invisible': [('delivery_type', '!=', 'ups')]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
